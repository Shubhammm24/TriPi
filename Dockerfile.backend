FROM python:3.12-slim

WORKDIR /app

# Install system deps (includes libpq for psycopg2)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy app code
# agent/, tools/, rag/ are at project root — imported by Django via sys.path
COPY agent/ agent/
COPY tools/ tools/
COPY rag/ rag/
COPY utils/ utils/
COPY backend/ backend/

# Set Django settings module
ENV DJANGO_SETTINGS_MODULE=tripi_project.settings
ENV PYTHONPATH=/app/backend:/app

# Expose port
EXPOSE 8000

# Run migrations and start Gunicorn
# Why migrations in CMD instead of a separate init container?
# - Simpler for dev/small deployments. In production, use a separate
#   migration job or init container.
CMD cd backend && python manage.py migrate --noinput && \
    gunicorn tripi_project.wsgi:application --bind 0.0.0.0:8000 --workers 4 --timeout 120
