# Required — Google Gemini API key for AI agent
GOOGLE_API_KEY=your_gemini_api_key_here

# Django
DJANGO_SECRET_KEY=change-me-before-deploying-to-production
DJANGO_DEBUG=True

# PostgreSQL
POSTGRES_DB=tripi
POSTGRES_USER=tripi
POSTGRES_PASSWORD=tripi_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (Celery broker)
REDIS_URL=redis://localhost:6379/0

# Optional — enhances agent capabilities
SERPAPI_KEY=              # Premium web search (free: 100 searches/mo)
AMADEUS_API_KEY=          # Flight/hotel search (free test tier)
AMADEUS_API_SECRET=       # Amadeus authentication secret

# Optional — enables destination photos in itinerary results
UNSPLASH_ACCESS_KEY=      # Free: unsplash.com/developers (50 req/hr)